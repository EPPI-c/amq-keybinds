{
  "manifest_version": 3,
  "name": "Awesomplete Replacer",
  "version": "1.0",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://animemusicquiz.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/awesomplete.js"],
      "matches": ["https://animemusicquiz.com/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}

