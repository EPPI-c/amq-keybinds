{
  "manifest_version": 3,
  "name": "Awesomplete Replacer",
  "version": "1.0",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://animemusicquiz.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
      {
          "matches": ["https://animemusicquiz.com/*"],
          "js": ["content.js"]
      }
  ],
  "web_accessible_resources": [
      {
          "resources": ["libs/awesomplete.js", "skip.js"],
          "matches": ["https://animemusicquiz.com/*"]
      }
  ],
  "declarative_net_request": {
      "rule_resources": [
          {
              "id": "ruleset_1",
              "enabled": true,
              "path": "rules.json"
          }
      ]
  }
}

